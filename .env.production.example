POSTGRES_USER=sirius
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sirius

JWT_SECRET=CHANGE_ME
ADMIN_NOTIFY_EMAIL=sirius.studio22@gmail.com

# Compte admin (connexion /espace-admin) — créé ou mis à jour au démarrage de l’API
ADMIN_EMAIL=sirius.studio22@gmail.com
ADMIN_PASSWORD=mettre-un-mot-de-passe-fort-min-8-caracteres
ADMIN_NAME=Meriem Zahzouh
RESEND_API_KEY=CHANGE_ME
MAIL_FROM=Sirius Studio <contact@votredomaine.fr>

# URL du site Netlify (sans slash final)
PUBLIC_APP_URL=https://votre-site.netlify.app
CORS_ORIGIN=https://votre-site.netlify.app

# false en prod (pas de comptes marie@demo / Admin2026!). true seulement pour un bac à sable jetable.
SEED_ON_START=false

# OAuth (URL publique de l’API, sans slash final)
OAUTH_REDIRECT_BASE=https://api.votredomaine.fr
