# Copier vers .env.production sur le VPS (ne pas committer)

# Domaine API (DNS A → IP du VPS)
API_DOMAIN=api.votredomaine.fr

POSTGRES_USER=sirius
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sirius

JWT_SECRET=CHANGE_ME
ADMIN_NOTIFY_EMAIL=votre@gmail.com
RESEND_API_KEY=CHANGE_ME
MAIL_FROM=Sirius Studio <contact@votredomaine.fr>

# URL du site Netlify (sans slash final)
PUBLIC_APP_URL=https://votre-site.netlify.app
CORS_ORIGIN=https://votre-site.netlify.app

# true uniquement au tout premier déploiement (données démo), puis false
SEED_ON_START=true

# OAuth (URL publique de l’API, sans slash final)
OAUTH_REDIRECT_BASE=https://api.votredomaine.fr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
